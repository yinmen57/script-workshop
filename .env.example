# 复制为 .env 后按本地环境填写；禁止提交真实密钥

# 应用
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=42867
APP_DEBUG=true
# 管理端 Origin（前后端分离 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=120
API_KEY_HASH_SALT=change-me-salt
SECRET_ENCRYPT_KEY=change-me-32-bytes-base64-or-passphrase

# MySQL（宿主机映射端口；api 容器内会被 compose 覆盖为 mysql:3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=ai_platform
MYSQL_PASSWORD=change-me-mysql
MYSQL_DATABASE=ai_platform
MYSQL_ROOT_PASSWORD=change-me-root

# Redis（api 容器内覆盖为 redis:6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant（api 容器内覆盖为 qdrant:6333）
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# 阿里云 OSS（官方 oss2；真实密钥只写 .env，勿提交）
# Endpoint 填地域域名，不要带 bucket
OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/
# 浏览器直传需补全 RAM 角色 ARN，例如：acs:ram::账号ID:role/角色名
OSS_STS_ROLE_ARN=
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_STS_DURATION_SECONDS=900

# 异步队列：redis_stream（P0）
QUEUE_BACKEND=redis_stream
QUEUE_STREAM_KEY=ai_platform:ingest
# 剧本业务作业 Stream（第三段 Worker）
SCRIPT_JOB_STREAM_KEY=ai_platform:script_jobs
SCRIPT_JOB_GROUP=script-workers
SCRIPT_JOB_CONSUMER_PREFIX=worker

# 默认 Chat LLM（火山方舟；真实密钥只写 .env）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-flash-260425
LLM_API_KEY=
LLM_TIMEOUT=60

# Agent 应用总空间：每个一级目录对应一个业务 Agent
AGENT_WORKSPACE_ROOT=apps-space

# 外部 Xinference（本项目不部署；填 supervisor 地址，勿填副本 worker 端口）
XINFERENCE_BASE_URL=http://10.109.0.221:9997
# api 容器访问 Xinference（内网可达时与上面相同）
XINFERENCE_BASE_URL_DOCKER=http://10.109.0.221:9997
XINFERENCE_EMBEDDING_MODEL_UID=bge-m3
XINFERENCE_RERANK_MODEL_UID=bge-reranker-v2-m3

# 赏舞（sd-2-c）开放 API：生图 / 生视频 / 素材（真实值只写 .env，勿提交）
# 完整配置说明见 docs/business-script-material/03-sd-config.md
# 调用说明见 docs/business-script-material/02-sd-api-key-and-calls.md
# ---- sd-2-c 图像 / 视频 ----
SD_ENABLED=true
SD_BASE_URL=http://115.191.32.99:8080
SD_API_KEY=
SD_IMAGE_MODEL=doubao-seedream-5-0-260128
SD_VIDEO_MODEL=doubao-seedance-2-0-260128
SD_RESOLUTION=2K
SD_CHARACTER_SIZE=3:4
SD_THREE_VIEW_SIZE=16:9
SD_CHARACTER_VIEW_SIZE=21:9
SD_BACKGROUND_SIZE=16:9
SD_REQUEST_TIMEOUT_SECONDS=60
SD_POLL_INTERVAL_SECONDS=3
SD_POLL_TIMEOUT_SECONDS=300
SD_VIDEO_DURATION=-1
SD_VIDEO_RESOLUTION=480p
SD_VIDEO_RATIO=adaptive
SD_VIDEO_POLL_INTERVAL_SECONDS=5
SD_VIDEO_POLL_TIMEOUT_SECONDS=600
SD_PORTRAIT_POLL_INTERVAL_SECONDS=5
SD_PORTRAIT_POLL_TIMEOUT_SECONDS=300
SD_PORTRAIT_WAIT_ON_SUBMIT=true



# 管理端：本机 npm 运行，代理到 Docker 暴露的 API
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:42867
