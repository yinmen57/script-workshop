# 复制为 .env 后按本地环境填写；禁止提交真实密钥

# 应用
APP_ENV=dev
APP_HOST=0.0.0.0
# 框架 API（应用空间 / chat / 向量 / AI Key）
APP_PORT=42867
# 业务 API（/script-biz）
BIZ_APP_PORT=42868
APP_DEBUG=true
# 管理端 Origin（前后端分离 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=120
API_KEY_HASH_SALT=change-me-salt
SECRET_ENCRYPT_KEY=change-me-32-bytes-base64-or-passphrase

# MySQL（宿主机映射端口；api 容器内会被 compose 覆盖为 mysql:3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=ai_platform
MYSQL_PASSWORD=change-me-mysql
MYSQL_DATABASE=ai_platform
MYSQL_ROOT_PASSWORD=change-me-root

# Redis（api 容器内覆盖为 redis:6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant（api 容器内覆盖为 qdrant:6333）
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# 阿里云 OSS / STS
OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_STS_ROLE_ARN=
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_STS_DURATION_SECONDS=900

# 阿里云短信（验证码登录）
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_LOGIN_TEMPLATE_CODE=
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_CODE_EXPIRE_SECONDS=300
SMS_RESEND_SECONDS=60
SMS_MAX_ATTEMPTS=5

# 作业总线：Celery + RabbitMQ
CELERY_BROKER_URL=amqp://ai:ai_platform@127.0.0.1:5672//
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=sync
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
GEN_MAX_INFLIGHT_PER_TENANT=3
GEN_SUBMIT_BATCH=20
GEN_POLL_BATCH=50
RABBITMQ_USER=ai
RABBITMQ_PASSWORD=ai_platform
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# AI Key（Chat / Embedding / Rerank / 赏舞生图 image / 赏舞生视频 video）在管理端配置

# 管理端：本机 npm 运行，代理到 Docker 暴露的 API
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:42867
